<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team_04.controller.EventosController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Gestión de Eventos" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Descripción:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDescripcion" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Fecha:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpFecha" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Lugar:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtLugar" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Modalidad:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbModalidad" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Estado:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbEstado" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Guardar" onAction="#guardarEvento"/>
        <Button text="Editar" onAction="#actualizarEvento"/>
        <Button text="Limpiar" onAction="#limpiarCampos"/>
        <Button text="Eliminar" onAction="#eliminarEvento"/>
        <Button text="Reporte PDF" onAction="#generarReporte"/>
    </HBox>

    <TableView fx:id="tablaEventos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
            <TableColumn fx:id="colLugar" text="Lugar" prefWidth="120"/>
            <TableColumn fx:id="colModalidad" text="Modalidad" prefWidth="100"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>